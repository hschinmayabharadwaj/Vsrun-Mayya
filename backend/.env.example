PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
USE_MOCK_DB=true

# Production: set USE_MOCK_DB=false and use the same Firebase project ID.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase (set USE_MOCK_DB=false to enable)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Railway: use FIREBASE_SERVICE_ACCOUNT_JSON as a sealed/multiline variable instead of a key file.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
