PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
USE_MOCK_DB=true

# Firebase Admin is required for protected routes. Keep USE_MOCK_DB=true to
# use in-memory application data locally, or set it to false for Firestore.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Admin credentials (required for protected routes)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Railway: use FIREBASE_SERVICE_ACCOUNT_JSON as a sealed/multiline variable instead of a key file.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
