# Backend Configuration

# Database mode: true for in-memory (demo), false for Firebase
USE_MOCK_DB=true

# CORS configuration - set to your Vercel frontend URL
CORS_ORIGIN=http://localhost:3000
# For production:
# CORS_ORIGIN=https://your-app.vercel.app

# Firebase Configuration (optional - only needed if USE_MOCK_DB=false)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Port (HF Spaces uses 7860, local uses 4000)
PORT=4000
