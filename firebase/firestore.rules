rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public service catalogue. All mutations go through the FastAPI backend.
    match /services/{serviceId} {
      allow read: if true;
      allow write: if false;
    }

    // Citizen-owned data. The backend writes these documents with the Admin SDK;
    // clients may only read records belonging to their authenticated account.
    match /applications/{applicationId} {
      allow read: if request.auth != null
        && resource.data.citizenId == request.auth.uid;
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null
        && resource.data.citizenId == request.auth.uid;
      allow write: if false;
    }

    match /grievances/{grievanceId} {
      allow read: if request.auth != null
        && resource.data.citizenId == request.auth.uid;
      allow write: if false;
    }

    // Drafts are also managed by the backend, so they cannot be forged from a
    // browser. The citizen ownership check still protects direct reads.
    match /drafts/{draftId} {
      allow read: if request.auth != null
        && resource.data.citizenId == request.auth.uid;
      allow write: if false;
    }

    // Deny every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
